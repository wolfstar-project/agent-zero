{
  "name": "@agent-zero/server",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "tsc -b --clean",
    "dev": "vite dev",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --type-check src server shared",
    "start": "node .output/server/index.mjs",
    "test": "vitest run src",
    "typecheck": "tsc --project tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@agent-zero/agent": "workspace:*",
    "@agent-zero/config": "workspace:*",
    "@agent-zero/models": "workspace:*",
    "@agent-zero/runner": "workspace:*",
    "@agent-zero/shared": "workspace:*",
    "@agent-zero/source-control": "workspace:*",
    "@orpc/server": "2.0.0-beta.26",
    "nitro": "^3.0.260610-beta",
    "vite-hub": "^0.0.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "oxlint": "^1.44.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  }
}
