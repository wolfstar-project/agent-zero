{
  "name": "@agent-zero/server",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "tsc -b --clean",
    "dev": "vite dev",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --type-check src server",
    "start": "node .output/server/index.mjs",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc --project tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@agent-zero/api": "workspace:*",
    "@agent-zero/shared": "workspace:*",
    "@orpc/openapi": "2.0.0-beta.26",
    "@orpc/server": "2.0.0-beta.26",
    "@orpc/zod": "2.0.0-beta.26",
    "nitro": "^3.0.260610-beta",
    "vite-hub": "^0.0.3"
  },
  "devDependencies": {
    "oxlint": "^1.44.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  }
}
