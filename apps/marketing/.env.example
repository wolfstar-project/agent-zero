# Environment for the marketing site process (apps/marketing): a frontend-only
# Nuxt app with no persistence and no credentials.
#
# Copy to `apps/marketing/.env`. Nuxt loads the `.env` sitting next to
# `nuxt.config.ts` on its own, for `nuxt dev`, `nuxt build`, and `nuxt preview`
# alike — no flag, and no file from the repository root. Real environment
# variables always win over the file, so a deployment sets them directly and
# ships no `.env` at all.
#
# The repository-root `.env.example` documents the `zero` CLI's own file and
# lists which section lives where.

# This is a prerendered site with no incoming request to auto-detect an origin from, so unlike the
# dashboard's NUXT_PUBLIC_SITE_URL (optional there), this has to be set for a production build.
MARKETING_SITE_URL=http://localhost:3001
# Where the marketing site's "Sign in" link and primary calls to action point.
MARKETING_DASHBOARD_URL=http://localhost:3000
