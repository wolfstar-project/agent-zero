{
  "repository": {
    "name": "wolfstar-project/agent-zero",
    "rootDir": "apps/dashboard"
  },
  "defaultLocale": {
    "label": "English",
    "lang": "en"
  },
  "locales": [
    {
      "label": "Italiano",
      "lang": "it"
    }
  ],
  "files": [
    {
      "location": "i18n/locales/en/**/*.json",
      "pattern": "i18n/locales/@lang/@path",
      "type": "dictionary"
    }
  ]
}
