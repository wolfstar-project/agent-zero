# Environment for the dashboard process (apps/dashboard): UI, oRPC/OpenAPI
# routes, webhook ingress, and authentication, all on one origin (default port
# 3000, override with PORT).
#
# Copy to `apps/dashboard/.env`. Nuxt loads the `.env` sitting next to
# `nuxt.config.ts` on its own, for `nuxt dev`, `nuxt build`, and `nuxt preview`
# alike — no flag, and no file from the repository root. Real environment
# variables always win over the file, so a deployment sets them directly and
# ships no `.env` at all.
#
# The repository-root `.env.example` documents the `zero` CLI's own file and
# lists which section lives where.

# Model providers. Duplicated from the root `.env` (which configures the CLI)
# because the control plane hosted here executes runs in this process: the
# dashboard needs its own credentials rather than inheriting the CLI's. The root
# file annotates the subscription transports (AGENT_ZERO_ENABLE_*,
# AGENT_ZERO_CLAUDE_CODE_*, AGENT_ZERO_MODEL_FALLBACK_*); set them here too when
# this deployment should run them.
OPENAI_API_KEY=
AGENT_ZERO_MODEL=gpt-5
GITHUB_TOKEN=

# Control-plane API (packages/api), served at /rpc/** and /api/v1/**. Fails closed: without
# AGENT_ZERO_CONTROL_PLANE_TOKENS every mutation is rejected while reads stay open.
# Comma-separated name:token bearer credentials.
AGENT_ZERO_CONTROL_PLANE_TOKENS=
# Comma-separated repository paths tasks.create may target.
AGENT_ZERO_CONTROL_PLANE_REPOSITORIES=
# Comma-separated name:mode|mode execution-mode grants. Without a grant a principal may only
# request the non-writable observe and suggest modes.
AGENT_ZERO_CONTROL_PLANE_MODES=
# Comma-separated origins allowed to read /api/v1/** cross-origin via CORS. Empty by default:
# tasks.list/tasks.get/health are unauthenticated by design, so letting a browser read their
# responses from another origin is an explicit opt-in, not the default.
AGENT_ZERO_CONTROL_PLANE_ORIGINS=

GITHUB_WEBHOOK_SECRET=
# Checkout the webhook route binds incoming events to. POST /webhooks/github fails closed
# (503, nothing ingested) until both this and GITHUB_WEBHOOK_SECRET are set.
AGENT_ZERO_CHECKOUT_PATH=

# Database (packages/database). Owns the schema and the migrations; this app is the only process
# that opens it. The pre-split name AUTH_DATABASE_URL is still read when this is unset.
# `packages/database/.env` carries the same connection string for drizzle-kit: keep the two
# pointing at one database, or migrations and the running server disagree about which store they
# mean. `server/auth.config.ts` resolves this at module load, so an unset value fails the server on
# its first request rather than degrading quietly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_zero_auth

# Authentication (server/auth.config.ts), mounted in-process at /api/auth/**.
# Generate the secret with: openssl rand -base64 32
# Use the NUXT_-prefixed name: the module requires it in production and only falls back to
# BETTER_AUTH_SECRET in development.
NUXT_BETTER_AUTH_SECRET=
# Registration is closed unless this is exactly "true".
AUTH_ENABLE_SIGNUP=false
# Both halves are required before the GitHub button is offered.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Organizations are off unless this is exactly "true". Enabling them requires a working mail
# transport below, because invitations are delivered by email.
AUTH_ENABLE_ORGANIZATIONS=false
# Whether any signed-in user may create an organization. Ignored while organizations are off.
AUTH_ALLOW_ORGANIZATION_CREATION=false
# Invitations are off unless this is exactly "true". Enabling them requires a working mail
# transport below: a private invitation's link is never shown to whoever created it, so email is
# the only path it travels. Independent of AUTH_ENABLE_SIGNUP — with registration closed they are
# the only way in, and with it open they grant roles and organization membership instead.
AUTH_ENABLE_INVITATIONS=false

# Mail (packages/mail). "console" logs instead of delivering and is the default, so an
# unconfigured deployment cannot silently attempt real delivery. Use "resend" or "smtp" in
# production.
MAIL_PROVIDER=console
MAIL_FROM=noreply@example.com
# Required when MAIL_PROVIDER=resend.
RESEND_API_KEY=
# Required when MAIL_PROVIDER=smtp. SMTP_SECURE is implicit TLS: true on 465, false on 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Sign-in capabilities are derived from AUTH_ENABLE_SIGNUP and the GitHub OAuth credentials above
# at build time, so rebuild whenever those policy values change. NUXT_PUBLIC_SITE_URL is optional:
# the auth module auto-detects the base URL from the incoming request, and this only needs to be
# set for a custom domain or deterministic OAuth callbacks.
NUXT_PUBLIC_SITE_URL=
PORT=3000

# Deployment target, read at build time only: it selects the ViteHub deployment preset (see
# config/hosting.ts), which in turn fixes the Nitro preset the build emits and the KV driver task
# history resolves. Unset builds the self-hosted bundle in .output/; apps/dashboard/vercel.json
# sets NITRO_PRESET=vercel so a Vercel build writes .vercel/output instead. VITEHUB_HOSTING names
# the same target in ViteHub's own spelling and wins over NITRO_PRESET.
NITRO_PRESET=
VITEHUB_HOSTING=
# Read at runtime by the Upstash KV store a hosted preset resolves, because a serverless function
# has no writable filesystem to keep task history on. Unused by the self-hosted `node` preset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
