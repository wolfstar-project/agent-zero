# Dashboard (`aube run dev --filter=@agent-zero/dashboard`).
#
# This process also hosts the control plane, model/source-control adapters, authentication,
# database, and mail composition roots. Model and source-control credentials intentionally appear
# here as well as in the root CLI template because the two processes are configured independently.

OPENAI_API_KEY=
AGENT_ZERO_MODEL=gpt-5
GITHUB_TOKEN=

# Subscription model transports (model.provider: claude-code / codex-cli). These take no API key:
# they drive the vendor CLI already logged in on this host, so they are single-tenant and bound to
# this machine. Each stays off unless its flag is exactly "true".
AGENT_ZERO_ENABLE_CLAUDE_CODE_PROVIDER=false
AGENT_ZERO_ENABLE_CODEX_CLI_PROVIDER=false
AGENT_ZERO_CLAUDE_CODE_PATH=
AGENT_ZERO_CODEX_PATH=
# Required when runner.isolation is "container" in .agent-zero.yml.
AGENT_ZERO_CLAUDE_CODE_CONTAINER_IMAGE=
AGENT_ZERO_CLAUDE_CODE_CONTAINER_EXECUTABLE=
CLAUDE_CONFIG_DIR=
AGENT_ZERO_SUBSCRIPTION_LIMIT_WAIT_MS=3600000
AGENT_ZERO_MODEL_FALLBACK_PROVIDER=
AGENT_ZERO_MODEL_FALLBACK_MODEL=

# Control-plane API, served at /rpc/** and /api/v1/**. Without tokens, mutations fail closed while
# reads stay open.
AGENT_ZERO_CONTROL_PLANE_TOKENS=
AGENT_ZERO_CONTROL_PLANE_REPOSITORIES=
AGENT_ZERO_CONTROL_PLANE_MODES=
AGENT_ZERO_CONTROL_PLANE_ORIGINS=

# POST /webhooks/github fails closed until both values are set.
GITHUB_WEBHOOK_SECRET=
AGENT_ZERO_CHECKOUT_PATH=

# Database. The legacy AUTH_DATABASE_URL is accepted only when DATABASE_URL is unset.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_zero_auth

# Authentication. Generate the production secret with: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=
AUTH_ENABLE_SIGNUP=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_ENABLE_ORGANIZATIONS=false
AUTH_ALLOW_ORGANIZATION_CREATION=false
AUTH_ENABLE_INVITATIONS=false

# Mail. "console" logs instead of delivering; use "resend" or "smtp" in production.
MAIL_PROVIDER=console
MAIL_FROM=noreply@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Public dashboard origin and local port. Auth capabilities above are captured at build time, so
# rebuild after changing them.
NUXT_PUBLIC_SITE_URL=
PORT=3000
