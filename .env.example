OPENAI_API_KEY=
AGENT_ZERO_MODEL=gpt-5
AGENT_ZERO_PORT=4040
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Authentication, mounted at /api/auth/** in apps/server (packages/api's Hono app).
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
AUTH_DASHBOARD_ORIGIN=http://localhost:3000
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_zero_auth
# Registration is closed unless this is exactly "true".
AUTH_ENABLE_SIGNUP=false
# Both halves are required before the GitHub button is offered.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dashboard (apps/dashboard). Points the Better Auth client at apps/server. Sign-in capabilities
# are derived from AUTH_ENABLE_SIGNUP and the GitHub OAuth credentials above at build time, so
# rebuild the dashboard whenever those policy values change.
NUXT_PUBLIC_SITE_URL=http://localhost:3001
